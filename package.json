{
  "name": "breero",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "types:generate": "openapi-typescript apps/api/openapi.json --output packages/types/src/generated/openapi.ts",
    "types:check": "pnpm types:generate && git diff --exit-code -- packages/types/src/generated/openapi.ts",
    "contract:check": "pnpm types:check && node scripts/check-frontend-openapi.mjs"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "turbo": "^2.3.0"
  },
  "pnpm": {
    "overrides": {
      "vitest": "3.2.6",
      "vite": "6.4.3",
      "sharp": "0.35.0",
      "postcss": "8.5.18"
    }
  }
}
