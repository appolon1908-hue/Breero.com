{
  "name": "breero",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "pnpm format:check && turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "contract:check": "node scripts/check-frontend-openapi.mjs",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,json}\" \"packages/**/*.{ts,tsx,css,json}\" \"*.json\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,json}\" \"packages/**/*.{ts,tsx,css,json}\" \"*.json\""
  },
  "devDependencies": {
    "prettier": "3.4.2",
    "turbo": "^2.3.0"
  },
  "pnpm": {
    "overrides": {
      "vitest": "3.2.6",
      "vite": "6.4.3",
      "sharp": "0.35.0",
      "postcss": "8.5.23"
    }
  }
}
