APP_ENV=staging
DATABASE_URL_FILE=/run/secrets/breero_staging_database_url
REDIS_URL_FILE=/run/secrets/breero_staging_redis_url
JWT_SECRET_FILE=/run/secrets/breero_staging_jwt_access_secret
JWT_REFRESH_SECRET_FILE=/run/secrets/breero_staging_jwt_refresh_secret
CORS_ORIGINS=https://staging.breero.com
STRIPE_ENABLED=false
PAYMENTS_ENABLED=false
ONLINE_CHECKOUT_ENABLED=false
PAID_LEADS_ENABLED=false
AUTOMATIC_REFUNDS_ENABLED=false
AUTOMATIC_BOOKING_ENABLED=false
AUTOMATIC_PROVIDER_ASSIGNMENT_ENABLED=false
AUTOMATIC_CONFIRMED_BOOKINGS=false
GEOCODING_ENABLED=false
EMAIL_ENABLED=false
SMS_ENABLED=false
ODOO_ENABLED=false
MIDDLEWARE_ENABLED=false
MIDDLEWARE_URL=https://middleware.internal.codestra.agency
MIDDLEWARE_CA_FILE=/run/secrets/codestra_private_ca.pem
MIDDLEWARE_CLIENT_CERT_FILE=/run/secrets/breero_middleware_client.pem
MIDDLEWARE_CLIENT_KEY_FILE=/run/secrets/breero_middleware_client.key
MIDDLEWARE_HMAC_KEY_ID=CHANGE_ME
MIDDLEWARE_HMAC_SECRET_FILE=/run/secrets/breero_middleware_hmac
MIDDLEWARE_SERVICE_IDENTITY=breero-staging
MIDDLEWARE_AUDIENCE=codestra-middleware-breero
MIDDLEWARE_TENANT=breero
MIDDLEWARE_SCOPE=breero.crm.events.submit
PAYOUT_ENABLED=false

# Observability
METRICS_ENABLED=true
METRICS_TOKEN_FILE=/run/secrets/breero_metrics_token
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus
# Tracing is opt-in; the endpoint points at the tempo service in
# deploy/observability/docker-compose.observability.yml.
TRACING_ENABLED=false
OTEL_SERVICE_NAME=breero-api
OTEL_EXPORTER_ENDPOINT=http://tempo:4318/v1/traces

