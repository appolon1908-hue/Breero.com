APP_ENV=staging
DATABASE_URL=postgresql+psycopg://breero_staging:CHANGE_ME@breero-staging-postgres:5432/breero_staging
REDIS_URL=redis://:CHANGE_ME@breero-staging-redis:6379/0
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_MINIMUM_32_CHARACTERS
CORS_ORIGINS=https://staging.breero.com
STRIPE_ENABLED=false
PAYMENTS_ENABLED=false
GEOCODING_ENABLED=false
PUBLIC_BOOKING_API_ENABLED=false
PROVIDER_ASSIGNMENT_MODE=MANUAL
AUTO_ASSIGN_PROVIDER=false
AUTO_CONFIRM_BOOKING=false
LIVE_PROVIDER_DISPATCH=false
LIVE_EMAIL_DELIVERY=false
LIVE_SMS_DELIVERY=false
LIVE_CALLBACKS=false
ODOO_DELIVERY_ENABLED=false
ODOO_WRITE_ENABLED=false
EMAIL_ENABLED=false
SMS_ENABLED=false
ODOO_ENABLED=false
MIDDLEWARE_ENABLED=false
MIDDLEWARE_URL=https://middleware.internal.codestra.agency
MIDDLEWARE_CA_FILE=/run/secrets/codestra_private_ca.pem
MIDDLEWARE_CLIENT_CERT_FILE=/run/secrets/breero_middleware_client.pem
MIDDLEWARE_CLIENT_KEY_FILE=/run/secrets/breero_middleware_client.key
MIDDLEWARE_HMAC_KEY_ID=CHANGE_ME
MIDDLEWARE_HMAC_SECRET_FILE=/run/secrets/breero_middleware_hmac
MIDDLEWARE_SERVICE_IDENTITY=breero-staging
MIDDLEWARE_AUDIENCE=codestra-middleware-breero
MIDDLEWARE_TENANT=breero
MIDDLEWARE_SCOPE=breero.crm.events.submit
PAYOUT_ENABLED=false
